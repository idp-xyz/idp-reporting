Subject: [PATCH] Fix trailer /Info with output intents; add /ID for PDF/A

---
 def.go                                 |   1 +
 fpdf.go                                |  12 ++++-
 pdf/reference/Fpdf_AddOutputIntent.pdf | Bin 3946 -> 4022 bytes
 trailer_test.go                        |  63 +++++++++++++++++++++++++
 4 files changed, 75 insertions(+), 1 deletion(-)
 create mode 100644 trailer_test.go

diff --git a/def.go b/def.go
index 9c0c2f4..9e90f8a 100644
--- a/def.go
+++ b/def.go
@@ -712,6 +712,7 @@ type Fpdf struct {
 	spotColorMap           map[string]spotColorType // Map of named ink-based colors
 	outputIntents          []OutputIntentType       // OutputIntents
 	outputIntentStartN     int                      // Start object number for
+	infoObjNum             int                      // Object number of the document information dictionary
 	userUnderlineThickness float64                  // A custom user underline thickness multiplier.
 
 	fmt struct {
diff --git a/fpdf.go b/fpdf.go
index a815e72..fd6f604 100644
--- a/fpdf.go
+++ b/fpdf.go
@@ -27,6 +27,7 @@ package fpdf
 
 import (
 	"bytes"
+	"crypto/md5"
 	"encoding/json"
 	"fmt"
 	"image"
@@ -5111,10 +5112,18 @@ func (f *Fpdf) putheader() {
 func (f *Fpdf) puttrailer() {
 	f.outf("/Size %d", f.n+1)
 	f.outf("/Root %d 0 R", f.n)
-	f.outf("/Info %d 0 R", f.n-1)
+	// Output intent profiles are written between the information dictionary and the catalog,
+	// so the dictionary is not necessarily object n-1.
+	f.outf("/Info %d 0 R", f.infoObjNum)
 	if f.protect.encrypted {
 		f.outf("/Encrypt %d 0 R", f.protect.objNum)
 		f.out("/ID [()()]")
+	} else if len(f.outputIntents) > 0 {
+		// PDF/A (and PDF 2.0) require a file identifier. It is written only for documents with
+		// an output intent so that other output stays byte-identical. Deriving it from the
+		// bytes written so far keeps output reproducible when the creation date is fixed.
+		sum := md5.Sum(f.buffer.Bytes())
+		f.outf("/ID [<%X> <%X>]", sum, sum)
 	}
 }
 
@@ -5239,6 +5248,7 @@ func (f *Fpdf) enddoc() {
 	f.putxmp()
 	// 	Info
 	f.newobj()
+	f.infoObjNum = f.n
 	f.out("<<")
 	f.putinfo()
 	f.out(">>")
