+package fpdf_test
+
+import (
+	"bytes"
+	"fmt"
+	"regexp"
+	"testing"
+
+	"codeberg.org/go-pdf/fpdf"
+)
+
+// trailerDoc returns the bytes of a one-page document, optionally with an output intent.
+func trailerDoc(t *testing.T, outputIntent bool) []byte {
+	t.Helper()
+	pdf := fpdf.New("P", "mm", "A4", "")
+	pdf.SetTitle("trailer", false)
+	if outputIntent {
+		pdf.AddOutputIntent(fpdf.OutputIntentType{SubtypeIdent: fpdf.OutputIntent_GTS_PDFA1,
+			OutputConditionIdentifier: "sRGB", Info: "sRGB", ICCProfile: []byte("not a real profile")})
+	}
+	pdf.AddPage()
+	var buf bytes.Buffer
+	if err := pdf.Output(&buf); err != nil {
+		t.Fatal(err)
+	}
+	return buf.Bytes()
+}
+
+// TestTrailerInfoReference checks that /Info names the information dictionary even when
+// output intent streams are written between it and the catalog.
+func TestTrailerInfoReference(t *testing.T) {
+	for _, intent := range []bool{false, true} {
+		doc := trailerDoc(t, intent)
+		trailer := doc[bytes.LastIndex(doc, []byte("trailer")):]
+		m := regexp.MustCompile(`/Info (\d+) 0 R`).FindSubmatch(trailer)
+		if m == nil {
+			t.Fatalf("output intent %v: no /Info in trailer %q", intent, trailer)
+		}
+		start := bytes.Index(doc, []byte(fmt.Sprintf("\n%s 0 obj", m[1])))
+		end := bytes.Index(doc[start:], []byte("endobj"))
+		if obj := doc[start : start+end]; !bytes.Contains(obj, []byte("/Producer")) {
+			t.Errorf("output intent %v: /Info %s 0 R is not the information dictionary: %q", intent, m[1], obj[:min(len(obj), 120)])
+		}
+	}
+}
+
+// TestTrailerFileIdentifier checks that an unencrypted document with an output intent carries
+// the non-empty /ID that PDF/A requires, that it is stable for identical input, and that a
+// document without an output intent is unchanged (no /ID).
+func TestTrailerFileIdentifier(t *testing.T) {
+	id := regexp.MustCompile(`/ID \[<([0-9A-F]{32})> <([0-9A-F]{32})>\]`)
+	first, second := trailerDoc(t, true), trailerDoc(t, true)
+	if id.Find(first[bytes.LastIndex(first, []byte("trailer")):]) == nil {
+		t.Fatal("document with an output intent has no non-empty /ID in its trailer")
+	}
+	if !bytes.Equal(first, second) {
+		t.Error("identical documents differ, so /ID is not deterministic")
+	}
+	plain := trailerDoc(t, false)
+	if bytes.Contains(plain[bytes.LastIndex(plain, []byte("trailer")):], []byte("/ID")) {
+		t.Error("document without an output intent gained an /ID")
+	}
+}
