{
  "session": {
    "identity": {
      "issuer": "urn:idp:contract-demo",
      "subject": "user_a",
      "tenant": "platform_demo"
    },
    "integrations": [
      "brant-contract-demo",
      "shipment-contract-demo"
    ]
  },
  "capabilities": {
