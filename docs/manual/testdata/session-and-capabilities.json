      "GET /catalog",
      "GET /companies",
      "POST /queries",
      "POST /snapshot-jobs",
      "GET /jobs/{id}",
      "POST /jobs/{id}/cancel",
      "GET /snapshots/{id}/rows",
      "POST /exports",
      "GET /artifacts/{id}/content",
      "GET /issues",
      "GET /issues/{id}"
    ],
    "source_interfaces": [
      "DescribeCatalog",
      "PrepareRead",
      "ReadPage",
      "AuthorizeCurrent"
    ],
    "template_routes": [
      "POST /issues",
      "GET, POST /document-templates",
      "GET /document-templates/{id}",
      "GET, POST /document-templates/{id}/release",
      "GET /document-templates/{id}/published",
      "POST /document-templates/{id}/previews"
    ]
  }
